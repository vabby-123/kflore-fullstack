# Server
PORT=4000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API (your storefront's URL(s))
CORS_ORIGIN=http://localhost:5173

# SQLite file location (created automatically on first run)
DATABASE_PATH=./data/kflore.db

# Required to call the /api/admin/* routes (order inbox). Send as:
#   Authorization: Bearer <this value>
ADMIN_API_KEY=change-me-to-a-long-random-string

# Your business WhatsApp number, digits only, country code first (no + or spaces).
# Used to build the customer-facing wa.me confirmation link returned by POST /api/orders.
STORE_WHATSAPP_NUMBER=60123456789

# Optional — WhatsApp Cloud API (Meta) credentials, only needed if you want the
# server itself to push a WhatsApp notification when an order comes in.
# Leave blank to skip: the storefront's own wa.me deep link still works without this.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_NOTIFY_TO=
